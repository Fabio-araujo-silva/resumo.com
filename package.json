{
  "name": "sinapse",
  "private": true,
  "description": "Sinapse: plataforma de assinatura de resumos feitos com IA, em notas atômicas, com modo prova e flashcards.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "node server/src/index.js",
    "cli": "node server/cli.js",
    "test": "npm test -w server",
    "test:e2e": "npm run build && playwright test",
    "test:tudo": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
