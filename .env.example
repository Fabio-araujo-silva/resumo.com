# resumo.com: configuração por variáveis de ambiente. Copie para .env (ou defina no serviço).

PORT=4310
# Onde ficam o banco, as figuras e os PDFs. Backup = copiar esta pasta.
DATA_DIR=./dados
NODE_ENV=production
# 1 quando há um proxy (Caddy, nginx) na frente: o IP do assinante vem do cabeçalho do proxy.
TRUST_PROXY=1
NOME_PLATAFORMA=resumo.com

# Administrador criado na primeira subida. Sem estas variáveis, um admin é criado com senha
# aleatória, mostrada no terminal e em DATA_DIR/PRIMEIRO-ACESSO.txt.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Admin

# Sessões
DIAS_SESSAO=14
# Quantos aparelhos um assinante mantém logados ao mesmo tempo (1 = entrar em outro derruba o anterior).
MAX_SESSOES=1

# Proteção do conteúdo
# Teto de notas diferentes abertas por conta.
LEITURAS_POR_10MIN=60
LEITURAS_POR_DIA=400
# 0 desliga a cortina que cobre o conteúdo quando a janela perde o foco.
DESFOCAR=1

# Flashcards: fuso dos assinantes em minutos em relação ao UTC (Brasília = -180).
FUSO_MIN=-180

# Leitura da nota em voz alta (ElevenLabs). Sem chave, o botão Ouvir usa a voz do navegador.
ELEVENLABS_API_KEY=
# Voz masculina (Brian), mais expressiva, sempre em português do Brasil.
VOZ_MASCULINA=nPczCjzI2devNBz1zQrb
VOZ_MODELO=eleven_multilingual_v2

# Geração de resumos com o Claude Code (precisa estar instalado onde o servidor roda).
CLAUDE_BIN=claude
# CLAUDE_MODELO=
CLAUDE_TIMEOUT_MIN=60
MAX_UPLOAD_MB=200
